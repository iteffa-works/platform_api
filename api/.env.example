# ===== API (Flowaxy) =====
# production — вмикає захищені cookie й перевірку секретів під час старту
NODE_ENV=development
PORT=4000

# Обовʼязково унікальний у production (≥ 32 символів): підписи тікетів, шифрування паролів панелей і 2FA.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me
APP_TITLE=Flowaxy
SESSION_TTL_DAYS=30
# Файли (аватари); за замовчуванням api/data — на сервері винести за межі каталогу релізу
# DATA_DIR=/var/lib/flowaxy/data
CURRENCY=UAH

# Client API (desktop / скрипти): у production — власний ключ
CLIENT_API_KEY=dev-client-key
CLIENT_RATE_LIMIT_PER_MINUTE=120

# ===== БД (MySQL / MariaDB) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flowaxy
DB_PASSWORD=
DB_NAME=flowaxy

# Розширення auth (1/0 | true/false | on/off)
AUTH_CAPTCHA=true
AUTH_FORM=true

# Чернетки міграцій *.draft.ts — лише для тестової БД
# MIGRATIONS_DRAFTS=1

# ===== Хостинг =====
# Фонове завдання: строки оплати, блокування, синхронізація з панелями (хв)
HOSTING_JOB_INTERVAL_MINUTES=10
# Видаляти в панелі акаунти, заблоковані за несплату, через N днів (0 — ніколи)
HOSTING_DELETE_AFTER_DAYS=0
