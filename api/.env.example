# API
PORT=4000
# Обовʼязково унікальний у production: підписи тікетів, шифрування секретів 2FA
APP_SECRET=change-me
APP_TITLE=Platform
SESSION_TTL_DAYS=30
# Файли (аватари); за замовчуванням api/data
# DATA_DIR=
CURRENCY=UAH
CLIENT_API_KEY=dev-client-key
CLIENT_RATE_LIMIT_PER_MINUTE=120

# MariaDB
DB_HOST=127.0.1.19
DB_PORT=3306
DB_USER=usr_internal
DB_PASSWORD=""
DB_NAME=db_sandbox

# Auth extensions (1/0 | true/false | on/off)
AUTH_CAPTCHA=true
AUTH_FORM=true

# Чернетки міграцій *.draft.ts — лише для тестової БД
# MIGRATIONS_DRAFTS=1
