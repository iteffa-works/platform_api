# ===== Web (SvelteKit, adapter-node) =====
# Публічний домен сайту: canonical, Open Graph, sitemap.xml, robots.txt
PUBLIC_APP_ORIGIN=https://example.com
PUBLIC_APP_NAME=Flowaxy
# Режим налагодження: сторінка помилки зі стеком і кодом. Не задано — увімкнено лише в `npm run dev`.
# У production — false (або не задавати)
PUBLIC_APP_DEBUG=false

# Сервер web (node build): адреса й порт за reverse proxy
HOST=127.0.0.1
PORT=3000
# Справжній домен для перевірки CSRF форм SvelteKit (той самий, що й PUBLIC_APP_ORIGIN)
ORIGIN=https://example.com
# За reverse proxy: справжня IP-адреса клієнта
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
